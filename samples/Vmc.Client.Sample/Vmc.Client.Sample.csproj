<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Vmc.Client.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <!-- A native executable ships no XML docs. The Compile-only AOT publish (dotnet/sdk#54515) also
         never copies them into OutDir, where publish looks (MSB3030). -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Non-shipped smoke-test app: don't gate the build on IDE code-style rules. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vmc.Client\Vmc.Client.csproj" />
  </ItemGroup>
</Project>
